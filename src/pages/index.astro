---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import { allTools, hubCategories } from '@/lib/tools';
import { siteConfig } from '@/config/site';
import { FEE_DATA_UPDATED } from '@/data/fees';
---

<BaseLayout
  title="Free Payment & Creator Fee Calculators"
  description="Calculate Stripe, PayPal, Square, Venmo, Cash App, Patreon, Ko-fi, Gumroad, Shopify and Wise fees. Forward and reverse calculators with dated schedules."
  canonicalPath="/"
  modified={FEE_DATA_UPDATED}
  isHome
  wide
>
  <section class="home-hero">
    <p class="brand-hero">{siteConfig.siteName}</p>
    <h1>Free payment processor & creator fee calculators</h1>
    <p class="lead">
      Calculate Stripe, PayPal, Square, Venmo, Cash App, Patreon, Ko-fi, Gumroad, Shopify Payments and Wise fees — forward
      and reverse — with dated schedules and source links. Runs entirely in your browser.
    </p>
    <div class="cta-row">
      <a class="btn btn--primary" href="/tools/stripe-fee-calculator/">Stripe calculator</a>
      <a class="btn btn--secondary" href="/tools/compare-payment-fees/">Compare processors</a>
    </div>
  </section>

  <Disclaimer compact />
  <AdSlot />

  <h2>All fee calculators</h2>
  <div class="tool-grid">
    {
      allTools.map((t) => (
        <a class="card-link" href={t.path}>
          <h3>{t.h1}</h3>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>

  <h2>Browse by category</h2>
  <div class="tool-grid">
    {
      hubCategories.map((h) => (
        <a class="card-link" href={h.path}>
          <h3>{h.title}</h3>
          <p>{h.description}</p>
        </a>
      ))
    }
  </div>

  <figure class="figure">
    <img
      src="/images/fee-breakdown.png"
      width="800"
      height="450"
      alt="Diagram showing a $100 customer payment split into processor fee and net payout"
      loading="lazy"
      decoding="async"
    />
    <figcaption>Every calculator shows fee, net, and reverse pricing from published schedules.</figcaption>
  </figure>

  <h2>Why these calculators</h2>
  <ul>
    <li>Forward “fee on amount” and reverse “charge to receive X” on every tool.</li>
    <li>Versioned fee file with official source URLs and last-verified dates.</li>
    <li>Client-side only — we never see the amounts you type.</li>
    <li>Comparison page across processors and creator platforms.</li>
  </ul>

  <h2>Fees on common amounts</h2>
  <div class="compare-with">
    <a href="/examples/fee-on-50/">$50</a>
    <a href="/examples/fee-on-100/">$100</a>
    <a href="/examples/fee-on-500/">$500</a>
    <a href="/examples/fee-on-1000/">$1,000</a>
  </div>

  <p>
    New here? Read <a href="/guides/how-to-price-after-fees/">how to price after payment fees</a> or our{' '}
    <a href="/methodology/">methodology</a>. Maintained by{' '}
    <a href={`/about/${siteConfig.authorHash}`}>{siteConfig.authorName}</a>.
  </p>
</BaseLayout>

<style>
  .home-hero {
    padding: 0.5rem 0 1rem;
  }
  .brand-hero {
    font-size: clamp(1.75rem, 5vw, 2.4rem);
    font-weight: 800;
    color: var(--color-brand);
    margin: 0 0 0.35rem;
    letter-spacing: -0.03em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
</style>
