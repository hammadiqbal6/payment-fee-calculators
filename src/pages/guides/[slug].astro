---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import SisterSites from '@/components/SisterSites.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { guides, getGuide } from '@/data/guides';
import { getRelatedTools } from '@/lib/tools';
import { sisterLinksByContext } from '@/lib/sisterLinks';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig, PERSON_ID } from '@/config/site';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const related = getRelatedTools(guide.relatedTools);
const relatedGuideLinks = (guide.relatedGuides ?? [])
  .map((slug) => getGuide(slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
const path = `/guides/${guide.slug}/`;
const pageUrl = new URL(path, siteConfig.siteUrl).toString();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: guide.title, href: path },
];
const sister =
  guide.slug === 'how-to-price-after-fees' ? (sisterLinksByContext['guide-price'] ?? []) : [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    datePublished: guide.published,
    dateModified: guide.modified,
    author: {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: siteConfig.authorName,
      url: `${siteConfig.siteUrl}/about/`,
    },
    publisher: { '@type': 'Organization', name: siteConfig.siteName, url: siteConfig.siteUrl },
    mainEntityOfPage: pageUrl,
  },
  breadcrumbList(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonicalPath={path}
  ogType="article"
  published={guide.published}
  modified={guide.modified}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>{guide.title}</h1>
  <p class="answer-first">{guide.answerFirst}</p>
  {
    guide.takeaways && guide.takeaways.length > 0 && (
      <div class="takeaways">
        <h2>Key takeaways</h2>
        <ul>
          {guide.takeaways.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    related.length > 0 && (
      <p class="compare-with">
        {related.slice(0, 2).map((t) => (
          <a href={t.path}>Calculate with {t.name ?? t.h1} →</a>
        ))}
      </p>
    )
  }
  <p class="byline meta-row--compact">
    By <a href={`/about/${siteConfig.authorHash}`} rel="author">{siteConfig.authorName}</a>
    · Updated <time datetime={guide.modified}>{guide.modified}</time>
  </p>
  <AdSlot />
  {
    guide.sections.map((section) => (
      <>
        <h2>{section.h2}</h2>
        {section.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        {section.list && (
          <ol>
            {section.list.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        )}
      </>
    ))
  }
  {
    guide.feeTable && (
      <div class="table-wrap">
        <table>
          <caption>{guide.feeTable.caption}</caption>
          <thead>
            <tr>
              {guide.feeTable.headers.map((h) => (
                <th scope="col">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {guide.feeTable.rows.map((row) => (
              <tr>
                {row.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <h2>Sources</h2>
  <ul>
    {
      guide.sources.map((s) => (
        <li>
          <a href={s.url} rel="noopener noreferrer" target="_blank">
            {s.label}
          </a>{' '}
          (as of {s.asOf})
        </li>
      ))
    }
  </ul>
  <h2>FAQ</h2>
  <div class="faq">
    {
      guide.faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
  <h2>Related calculators</h2>
  <div class="related">
    {related.map((t) => <a href={t.path}>{t.h1}</a>)}
    {guide.slug === 'stripe-vs-paypal-fees' && (
      <a href="/tools/compare-payment-fees/">Open the side-by-side fee comparison tool</a>
    )}
  </div>
  {
    relatedGuideLinks.length > 0 && (
      <>
        <h2>Related guides</h2>
        <div class="related">
          {relatedGuideLinks.map((g) => (
            <a href={`/guides/${g.slug}/`}>{g.title}</a>
          ))}
        </div>
      </>
    )
  }
  {
    guide.relatedHubs && guide.relatedHubs.length > 0 && (
      <>
        <h2>Related hubs</h2>
        <div class="related">
          {guide.relatedHubs.map((h) => (
            <a href={h.href}>{h.label}</a>
          ))}
        </div>
      </>
    )
  }
  <SisterSites links={sister} />
</BaseLayout>
