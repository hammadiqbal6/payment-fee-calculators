---
import BaseLayout from '@/layouts/BaseLayout.astro';

const guides = [
  {
    href: '/guides/how-to-price-after-fees/',
    title: 'How to price so you still receive what you need after fees',
    description:
      'Use reverse fee math to set list prices — including how much to charge to receive $100 after Stripe, PayPal and creator fees.',
  },
  {
    href: '/guides/stripe-vs-paypal-fees/',
    title: 'Stripe vs PayPal fees: which is cheaper?',
    description: 'Compare common US online rates, international add-ons, and when each wins. Links to the side-by-side tool.',
  },
  {
    href: '/guides/patreon-vs-kofi-vs-bmac/',
    title: 'Patreon vs Ko-fi vs Buy Me a Coffee fees',
    description: 'Platform commissions, processing, and when Gold or higher Patreon plans pay off.',
  },
  {
    href: '/guides/hidden-payment-fees/',
    title: 'Payment fees freelancers forget to budget',
    description: 'Chargebacks, instant payouts, currency conversion, and platform commissions.',
  },
];
---

<BaseLayout
  title="Guides: Payment & Creator Fees Explained"
  description="Practical guides on pricing after payment fees, Stripe vs PayPal, and creator platform fee comparisons."
  canonicalPath="/guides/"
>
  <h1>Guides</h1>
  <p class="lead">Explainers that interlink with the calculators — written for freelancers, sellers, and creators.</p>
  <div class="tool-grid">
    {
      guides.map((g) => (
        <a class="card-link" href={g.href}>
          <h2>{g.title}</h2>
          <p>{g.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
