---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { guides } from '@/data/guides';
---

<BaseLayout
  title="Guides: Payment & Creator Fees Explained"
  description="Practical guides on pricing after payment fees, Stripe vs PayPal, hidden freelancer fees, and creator platform fee comparisons."
  canonicalPath="/guides/"
>
  <h1>Guides</h1>
  <p class="lead">Explainers that interlink with the calculators — written for freelancers, sellers, and creators.</p>
  <div class="tool-grid">
    {
      guides.map((g) => (
        <a class="card-link" href={`/guides/${g.slug}/`}>
          <h2>{g.title}</h2>
          <p>{g.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
