---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { guides } from '@/data/guides';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig } from '@/config/site';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
];

const pageUrl = `${siteConfig.siteUrl}/guides/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Guides: Payment & Creator Fees',
    description:
      'Practical guides on pricing after fees, Stripe vs PayPal, creator platforms, P2P apps, and reverse fee math for freelancers.',
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: guides.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: `${siteConfig.siteUrl}/guides/${g.slug}/`,
    })),
  },
  breadcrumbList(crumbs),
];
---

<BaseLayout
  title="Guides: Payment & Creator Fees"
  description="Practical guides on pricing after fees, Stripe vs PayPal, creator platforms, P2P apps, and reverse fee math for freelancers."
  canonicalPath="/guides/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>Guides</h1>
  <p class="lead">Explainers that interlink with the calculators — written for freelancers, sellers, and creators.</p>
  <div class="tool-grid">
    {
      guides.map((g) => (
        <a class="card-link" href={`/guides/${g.slug}/`}>
          <h2>{g.title}</h2>
          <p>{g.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
