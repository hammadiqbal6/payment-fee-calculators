---
/**
 * Canonical author URL is /about/#maintainer (playbook).
 * This page exists only to 301 via public/_redirects; keep a noindex fallback
 * for hosts that ignore _redirects during local preview.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="Author"
  description={`Author information for ${siteConfig.siteName} lives on the About page.`}
  canonicalPath="/about/"
  noindex
>
  <h1>Author moved</h1>
  <p>
    Maintainer details are on the{' '}
    <a href={`/about/${siteConfig.authorHash}`}>About page</a>.
  </p>
  <meta http-equiv="refresh" content={`0;url=/about/${siteConfig.authorHash}`} />
</BaseLayout>
