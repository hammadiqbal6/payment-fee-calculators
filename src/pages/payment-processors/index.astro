---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { hubCategories, getRelatedTools } from '@/lib/tools';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig } from '@/config/site';

const hub = hubCategories[0];
const tools = getRelatedTools([...hub.toolIds]);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Payment processors', href: hub.path },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    url: siteConfig.siteUrl + hub.path,
    description: hub.description,
  },
  breadcrumbList(crumbs),
];
---

<BaseLayout
  title="Payment Processor Fee Calculators Hub"
  description="Hub for Stripe, PayPal, Square and Shopify Payments fee calculators with reverse pricing and dated fee tables."
  canonicalPath={hub.path}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>{hub.title}</h1>
  <p class="answer-first">
    Card processors typically charge a percent plus a fixed fee per successful payment. Start with Stripe or PayPal for
    online checkout, Square for in-person sales, and Shopify Payments if your store already runs on Shopify. Compare list
    rates with our{' '}
    <a href="/guides/square-vs-stripe-vs-shopify/">Square vs Stripe vs Shopify</a> and{' '}
    <a href="/guides/stripe-vs-paypal-fees/">Stripe vs PayPal</a> guides before you commit.
  </p>
  <p class="lead">{hub.description}</p>
  <div class="tool-grid">
    {
      tools.map((t) => (
        <a class="card-link" href={t.path}>
          <h2>{t.h1}</h2>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>
  <p>
    Also see the <a href="/tools/compare-payment-fees/">full comparison calculator</a> and{' '}
    <a href="/creator-fees/">creator platforms</a>.
  </p>
</BaseLayout>
