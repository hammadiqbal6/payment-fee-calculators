---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { hubCategories, getRelatedTools } from '@/lib/tools';
import { processors } from '@/data/fees';
import { calculateForward, formatMoney, formatPercent } from '@/lib/fees/calculate';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig } from '@/config/site';

const hub = hubCategories[0];
const tools = getRelatedTools([...hub.toolIds]);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Payment processors', href: hub.path },
];

const compareRows = tools
  .map((t) => {
    const p = processors.find((x) => x.id === t.id);
    if (!p) return null;
    const rate = p.rates.find((r) => r.id === p.defaultRateId) ?? p.rates[0];
    const fwd = calculateForward(100, rate);
    return { tool: t, rate, fwd };
  })
  .filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    url: siteConfig.siteUrl + hub.path,
    description: hub.description,
  },
  breadcrumbList(crumbs),
];
---

<BaseLayout
  title="Payment Processor Fee Calculators Hub"
  description="Hub for Stripe, PayPal, Square and Shopify Payments fee calculators with reverse pricing, dated fee tables, and worked examples for US and international cards."
  canonicalPath={hub.path}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>{hub.title}</h1>
  <p class="answer-first">
    Card processors typically charge a percent plus a fixed fee. On $100, Stripe US is $3.20 (2.9% + $0.30); PayPal US
    G&S is $2.99 (2.99%); Square Free online is $3.60 (3.3% + $0.30). Start with the calculator that matches your
    checkout, then compare with our guides.
  </p>
  <div class="tool-grid">
    {
      tools.map((t) => (
        <a class="card-link" href={t.path}>
          <h2>{t.h1}</h2>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>

  <h2>Which tool do I need?</h2>
  <div class="table-wrap">
    <table>
      <caption>$100 default-schedule snapshot</caption>
      <thead>
        <tr>
          <th>Processor</th>
          <th>Default schedule</th>
          <th>Fee on $100</th>
          <th>Calculator</th>
        </tr>
      </thead>
      <tbody>
        {
          compareRows.map((row) => (
            <tr>
              <td>{row!.tool.name}</td>
              <td>
                {row!.rate.label}: {formatPercent(row!.rate.percent)} + {row!.rate.fixed.toFixed(2)}
              </td>
              <td>{formatMoney(row!.fwd.fee, row!.rate.currency)}</td>
              <td>
                <a href={row!.tool.path}>Open</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Related guides</h2>
  <ul>
    <li><a href="/guides/stripe-vs-paypal-fees/">Stripe vs PayPal fees</a></li>
    <li><a href="/guides/square-vs-stripe-vs-shopify/">Square vs Stripe vs Shopify Payments</a></li>
    <li><a href="/guides/how-to-price-after-fees/">How to price after payment fees</a></li>
    <li><a href="/tools/compare-payment-fees/">Interactive comparison calculator</a></li>
  </ul>
</BaseLayout>
