---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { hubCategories, getRelatedTools } from '@/lib/tools';
import { processors } from '@/data/fees';
import { calculateForward, formatMoney, formatPercent } from '@/lib/fees/calculate';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig } from '@/config/site';

const hub = hubCategories[1];
const tools = getRelatedTools([...hub.toolIds]);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'P2P fees', href: hub.path },
];

const compareRows = tools
  .map((t) => {
    const p = processors.find((x) => x.id === t.id);
    if (!p) return null;
    const rate = p.rates.find((r) => r.id === p.defaultRateId) ?? p.rates[0];
    const fwd = calculateForward(100, rate);
    return { tool: t, rate, fwd };
  })
  .filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    url: siteConfig.siteUrl + hub.path,
    description: hub.description,
  },
  breadcrumbList(crumbs),
];
---

<BaseLayout
  title="P2P & Instant Pay Fee Calculators"
  description="Free Venmo, Cash App, Zelle and Wise transfer fee calculators for sellers and freelancers. Estimate business fees, instant deposits, and net payouts."
  canonicalPath={hub.path}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>{hub.title}</h1>
  <p class="answer-first">
    Peer-to-peer apps are often free for personal transfers, but business profiles add percent fees. On $100, Venmo
    Business is about $2.00, Cash App Business about $2.75, and Zelle is usually $0 at participating banks. Wise uses
    transparent FX fees by corridor — confirm a live quote.
  </p>
  <div class="tool-grid">
    {
      tools.map((t) => (
        <a class="card-link" href={t.path}>
          <h2>{t.h1}</h2>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>

  <h2>$100 business / transfer snapshot</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>App</th>
          <th>Default schedule</th>
          <th>Fee on $100</th>
          <th>Tool</th>
        </tr>
      </thead>
      <tbody>
        {
          compareRows.map((row) => (
            <tr>
              <td>{row!.tool.name}</td>
              <td>
                {row!.rate.label}: {formatPercent(row!.rate.percent)}
                {row!.rate.fixed ? ` + ${row!.rate.fixed.toFixed(2)}` : ''}
              </td>
              <td>{formatMoney(row!.fwd.fee, row!.rate.currency)}</td>
              <td>
                <a href={row!.tool.path}>Open</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Related guides</h2>
  <ul>
    <li><a href="/guides/venmo-vs-cash-app-vs-zelle/">Venmo vs Cash App vs Zelle fees</a></li>
    <li><a href="/guides/wise-vs-paypal-international/">Wise vs PayPal for international</a></li>
    <li><a href="/guides/hidden-payment-fees/">Hidden payment fees freelancers miss</a></li>
  </ul>
</BaseLayout>
