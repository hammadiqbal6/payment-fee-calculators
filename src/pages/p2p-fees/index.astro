---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { hubCategories, getRelatedTools } from '@/lib/tools';
import { breadcrumbList } from '@/lib/breadcrumbs';
import { siteConfig } from '@/config/site';

const hub = hubCategories[1];
const tools = getRelatedTools([...hub.toolIds]);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'P2P fees', href: hub.path },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    url: siteConfig.siteUrl + hub.path,
    description: hub.description,
  },
  breadcrumbList(crumbs),
];
---

<BaseLayout
  title="P2P & Instant Pay Fee Calculators"
  description="Venmo, Cash App, Zelle and Wise transfer fee calculators for sellers and freelancers."
  canonicalPath={hub.path}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1>{hub.title}</h1>
  <p class="answer-first">
    Peer-to-peer apps are often free for personal transfers, but business profiles, goods and services tags, and instant
    deposits add percent fees. Zelle is usually $0 at participating banks; Wise charges transparent FX transfer fees. See{' '}
    <a href="/guides/venmo-vs-cash-app-vs-zelle/">Venmo vs Cash App vs Zelle</a> for side-by-side planning.
  </p>
  <div class="tool-grid">
    {
      tools.map((t) => (
        <a class="card-link" href={t.path}>
          <h2>{t.h1}</h2>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
