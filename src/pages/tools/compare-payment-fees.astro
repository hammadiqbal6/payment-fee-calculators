---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import TrustBlock from '@/components/TrustBlock.astro';
import SisterSites from '@/components/SisterSites.astro';
import { processors, comparisonOrder, FEE_DATA_UPDATED, FEE_DATA_VERSION } from '@/data/fees';
import { calculateForward, formatMoney, formatPercent } from '@/lib/fees/calculate';
import { comparisonTool, getRelatedTools } from '@/lib/tools';
import { getGuidesForTool } from '@/data/relatedGuides';
import { sisterLinksByContext } from '@/lib/sisterLinks';
import { siteConfig, PERSON_ID } from '@/config/site';

const meta = comparisonTool;
const amount = 100;
const rows = comparisonOrder
  .map((id) => processors.find((p) => p.id === id))
  .filter(Boolean)
  .map((p) => {
    const rate = p!.rates.find((r) => r.id === p!.defaultRateId) ?? p!.rates[0];
    const result = calculateForward(amount, rate);
    return { processor: p!, rate, result };
  })
  .sort((a, b) => a.result.fee - b.result.fee);

const related = getRelatedTools(meta.related);
const learnMoreGuides = getGuidesForTool('comparison');
const compareRows = comparisonOrder
  .map((id) => processors.find((p) => p.id === id))
  .filter(Boolean)
  .map((p) => {
    const rate = p!.rates.find((r) => r.id === p!.defaultRateId) ?? p!.rates[0];
    return {
      name: p!.name,
      slug: p!.slug,
      label: rate.label,
      percent: rate.percent,
      fixed: rate.fixed,
      currency: rate.currency,
      sourceUrl: rate.sourceUrl,
      lastVerified: rate.lastVerified,
    };
  });
const compareRowsJson = JSON.stringify(compareRows);
const pageUrl = new URL(meta.path, siteConfig.siteUrl).toString();
const sister = sisterLinksByContext.comparison ?? [];

const trustSources = compareRows.map((r) => ({
  url: r.sourceUrl,
  label: `${r.name} — ${r.label}`,
  usedFor: `default schedule ${(r.percent * 100).toFixed(2)}% + ${r.fixed.toFixed(2)} ${r.currency}`,
  checked: r.lastVerified,
}));

/** Visible FAQ + FAQPage JSON-LD must stay in sync (seo.mjs enforces FAQPage when FAQ UI is present). */
const faqs = [
  {
    q: 'Which payment processor has the lowest fees?',
    a: 'It depends on average order value, country, and whether you need chargebacks protection. Zelle is often $0 but is not a full merchant stack. Compare with your real volume on this page, then open each calculator.',
  },
  {
    q: 'Should creators use Gumroad or Stripe?',
    a: 'Gumroad bundles storefront features with a higher take rate. Stripe is usually cheaper per payment if you already have a storefront. Run both calculators on your price point.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        '@id': `${pageUrl}#app`,
        name: meta.h1,
        url: pageUrl,
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Any',
        isAccessibleForFree: true,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description: meta.description,
        dateModified: FEE_DATA_UPDATED,
        author: {
          '@type': 'Person',
          '@id': PERSON_ID,
          name: siteConfig.authorName,
          url: `${siteConfig.siteUrl}/about/`,
        },
        publisher: { '@id': `${siteConfig.siteUrl}/#organization` },
      },
      {
        '@type': 'WebPage',
        '@id': `${pageUrl}#webpage`,
        url: pageUrl,
        name: meta.title,
        datePublished: '2026-10-19T00:00:00+05:00',
        dateModified: `${FEE_DATA_UPDATED}T00:00:00+05:00`,
        lastReviewed: FEE_DATA_UPDATED,
        author: { '@id': PERSON_ID },
        mainEntity: { '@id': `${pageUrl}#app` },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: meta.h1, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.path}
  modified={FEE_DATA_UPDATED}
  published="2026-10-19"
  jsonLd={jsonLd}
  wide
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>/</span> <span>Compare</span>
  </nav>
  <h1>{meta.h1}</h1>
  <p class="answer-first">
    Side-by-side default schedules on any amount. On $100, the cheapest default in this table is{' '}
    {formatMoney(rows[0].result.fee, rows[0].rate.currency)} ({rows[0].processor.name}); the highest is{' '}
    {formatMoney(rows[rows.length - 1].result.fee, rows[rows.length - 1].rate.currency)} (
    {rows[rows.length - 1].processor.name}). Lower fee is not always better — weigh protections and payout speed.
  </p>

  <section class="hero-tool" aria-label="Interactive comparison">
    <div id="compare-app" data-compare-app data-rows={compareRowsJson}>
      <label class="field" for="compare-amount">
        <span class="field__label">Compare amount</span>
        <input
          id="compare-amount"
          class="field__input"
          type="number"
          min="0"
          step="0.01"
          value="100"
          inputmode="decimal"
          data-amount
        />
      </label>
      <div class="table-wrap" style="margin-top:1rem">
        <table>
          <caption class="sr-only">Interactive fee comparison by processor</caption>
          <thead>
            <tr>
              <th scope="col">Processor</th>
              <th scope="col">Fee</th>
              <th scope="col">Net</th>
              <th scope="col">Effective</th>
            </tr>
          </thead>
          <tbody data-body></tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="takeaways">
    <h2>Key takeaways</h2>
    <ul>
      <li>
        On $100, {rows[0].processor.name} is the lowest default fee at{' '}
        {formatMoney(rows[0].result.fee, rows[0].rate.currency)}.
      </li>
      <li>
        Creator platforms (Patreon, Gumroad, etc.) blend platform commissions — they are not 1:1 with card processors.
      </li>
      <li>
        Open each tool to reverse-price a target net; see the{' '}
        <a href="/guides/stripe-vs-paypal-fees/">Stripe vs PayPal fees guide</a> for narrative context.
      </li>
    </ul>
  </div>

  <p class="byline">
    Built by <a href={`/about/${siteConfig.authorHash}`} rel="author">{siteConfig.authorName}</a>
    · Last reviewed <time datetime={FEE_DATA_UPDATED}>{FEE_DATA_UPDATED}</time>
    · Data {FEE_DATA_VERSION}
  </p>
  <Disclaimer compact />

  <AdSlot />

  <figure class="figure">
    <img
      src="/images/compare-fees.png"
      width="800"
      height="420"
      alt="Illustration comparing example Stripe, PayPal, and Square fees on a $100 charge"
      loading="lazy"
      decoding="async"
    />
    <figcaption>Illustrative default-schedule fees on $100 — change the amount above for live ranking.</figcaption>
  </figure>

  <p class="answer-first">
    On a $100 charge using each product’s default schedule in our dated dataset, in-person or P2P options can look
    cheapest, while creator platforms with platform commissions cost more. Use the interactive table to change the amount
    and sort by fee or net.
  </p>

  <h2>Static comparison at ${amount}</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processor</th>
          <th>Default schedule</th>
          <th>Rate</th>
          <th>Fee</th>
          <th>Net</th>
          <th>Tool</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ processor, rate, result }) => (
            <tr>
              <td>{processor.name}</td>
              <td>{rate.label}</td>
              <td>
                {formatPercent(rate.percent)} + {rate.fixed.toFixed(2)} {rate.currency}
              </td>
              <td>{formatMoney(result.fee, rate.currency)}</td>
              <td>{formatMoney(result.net, rate.currency)}</td>
              <td>
                <a href={`/tools/${processor.slug}/`}>Open calculator</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>How it’s calculated</h2>
  <p>
    For each processor we take the default schedule (percent + fixed), then fee = amount × percent + fixed and net =
    amount − fee. The interactive table re-runs that formula when you change the amount and sorts by fee ascending.
  </p>

  <h2>How to compare payment processors fairly</h2>
  <ol>
    <li>Match the same country and channel (online vs in-person vs P2P).</li>
    <li>Include platform commissions for creator tools (Patreon, Ko-fi, Gumroad).</li>
    <li>Price with reverse mode so your net margin survives fees.</li>
    <li>Verify live rates — custom Stripe/PayPal pricing can beat published list rates.</li>
  </ol>

  <h2>FAQ</h2>
  <div class="faq">
    {
      faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>

  <h2>Learn more</h2>
  <div class="related">
    {learnMoreGuides.map((g) => (
      <a href={`/guides/${g.slug}/`}>{g.title}</a>
    ))}
  </div>

  <SisterSites links={sister} />

  <h2>Related tools</h2>
  <div class="related">
    {related.map((t) => <a href={t.path}>{t.h1}</a>)}
  </div>

  <TrustBlock
    sources={trustSources}
    formula="fee = amount × percent + fixed; net = amount − fee (default schedule per processor)."
    lastReviewed={FEE_DATA_UPDATED}
  />
</BaseLayout>

<script>
  function round2(n) {
    return Math.round((n + Number.EPSILON) * 100) / 100;
  }
  function forward(charge, percent, fixed) {
    const fee = round2(charge * percent + fixed);
    const net = round2(charge - fee);
    return { fee, net, rate: charge === 0 ? 0 : fee / charge };
  }
  function money(n, currency) {
    try {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(n);
    } catch {
      return `${n.toFixed(2)} ${currency}`;
    }
  }

  const root = document.querySelector('[data-compare-app]');
  if (root) {
    const defaults = JSON.parse(root.dataset.rows || '[]');
    const input = root.querySelector('[data-amount]');
    const body = root.querySelector('[data-body]');

    const render = (fromUser = false) => {
      const amount = Number(input.value) || 0;
      const rows = defaults
        .map((d) => {
          const r = forward(amount, d.percent, d.fixed);
          return { ...d, r };
        })
        .sort((a, b) => a.r.fee - b.r.fee);
      body.innerHTML = rows
        .map(
          (row) => `<tr>
          <td><a href="/tools/${row.slug}/">${row.name}</a><div class="muted">${row.label}</div></td>
          <td>${money(row.r.fee, row.currency)}</td>
          <td>${money(row.r.net, row.currency)}</td>
          <td>${(row.r.rate * 100).toFixed(2)}%</td>
        </tr>`,
        )
        .join('');
      if (fromUser) {
        window.__feecalcTrack?.('compare_used', { amount });
      }
    };
    input.addEventListener('change', () => render(true));
    input.addEventListener('input', () => render(false));
    render(false);
  }
</script>

<style is:global>
  #compare-app .field {
    display: grid;
    gap: 0.35rem;
    max-width: 280px;
  }
  #compare-app .field__label {
    font-weight: 600;
  }
  #compare-app .field__input {
    min-height: 48px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    font-size: max(1rem, 16px);
    width: 100%;
    background: #fff;
  }
  #compare-app .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  #compare-app .muted {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  #compare-app td a,
  .table-wrap td a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
