---
import { siteConfig, PERSON_ID } from '@/config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: 'website' | 'article';
  published?: string;
  modified?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  wide?: boolean;
  /** When true, emit home-page WebSite/Organization/Person @graph once */
  isHome?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  published,
  modified,
  noindex = false,
  jsonLd = [],
  wide = false,
  isHome = false,
} = Astro.props;

const canonical = new URL(canonicalPath, siteConfig.siteUrl).toString();
/** Brand suffix only when it keeps the final title within 25–65 chars (SEO guardrail). */
const withBrand = `${title} | ${siteConfig.shortName}`;
const fullTitle =
  title.includes(siteConfig.shortName) || withBrand.length > 65 ? title : withBrand;
if (siteConfig.defaultOgImage.endsWith('/')) {
  throw new Error('siteConfig.defaultOgImage must not end with a trailing slash');
}
const ogImage = new URL(siteConfig.defaultOgImage, siteConfig.siteUrl).toString();
const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

const orgId = `${siteConfig.siteUrl}/#organization`;
const websiteId = `${siteConfig.siteUrl}/#website`;
const logoUrl = new URL(siteConfig.logoPath, siteConfig.siteUrl).toString();

const homeGraph = isHome
  ? [
      {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': websiteId,
            name: siteConfig.siteName,
            alternateName: [siteConfig.shortName],
            url: `${siteConfig.siteUrl}/`,
            inLanguage: siteConfig.language,
            description: siteConfig.description,
            publisher: { '@id': orgId },
          },
          {
            '@type': 'Organization',
            '@id': orgId,
            name: siteConfig.siteName,
            url: `${siteConfig.siteUrl}/`,
            email: siteConfig.contactEmail,
            foundingDate: String(siteConfig.foundedYear),
            logo: {
              '@type': 'ImageObject',
              url: logoUrl,
              width: 512,
              height: 512,
            },
            founder: { '@id': PERSON_ID },
            publishingPrinciples: `${siteConfig.siteUrl}/methodology/`,
          },
          {
            '@type': 'Person',
            '@id': PERSON_ID,
            name: siteConfig.authorName,
            url: `${siteConfig.siteUrl}/about/`,
            sameAs: [...siteConfig.authorSameAs],
          },
        ],
      },
    ]
  : [];

const nav = [
  { href: '/payment-processors/', label: 'Processors' },
  { href: '/creator-fees/', label: 'Creators' },
  { href: '/p2p-fees/', label: 'P2P' },
  { href: '/tools/compare-payment-fees/', label: 'Compare' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];

const gaId = siteConfig.ga4MeasurementId;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large" />
    )}
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
    <meta name="author" content={siteConfig.authorName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(siteConfig.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.ogImageHeight)} />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />
    {siteConfig.twitterHandle && <meta name="twitter:site" content={`@${siteConfig.twitterHandle}`} />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {siteConfig.bingSiteVerification && (
      <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
    )}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.siteName} guides`} href="/rss.xml" />
    {[...homeGraph, ...schemas].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {siteConfig.adsensePublisherId && siteConfig.adsenseAutoAds && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
        crossorigin="anonymous"
      />
    )}
    {/* Consent Mode v2 defaults denied until the user accepts; gtag loads after idle/interaction */}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500,
        });
        window.__FEECALC_GA_ID = gaId;
        window.__FEECALC_GA_LOADED = false;
        window.__feecalcLoadGa = function () {
          if (window.__FEECALC_GA_LOADED || !window.__FEECALC_GA_ID) return;
          window.__FEECALC_GA_LOADED = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.__FEECALC_GA_ID;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', window.__FEECALC_GA_ID, {
            anonymize_ip: true,
            send_page_view: true,
          });
        };
        window.__feecalcTrack = function (name, params) {
          if (typeof window.gtag === 'function') {
            window.gtag('event', name, params || {});
          }
        };
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">$</span>
          <span>{siteConfig.shortName}</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
          Menu
        </button>
        <nav class="site-nav" id="site-nav" data-nav aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class:list={['main', wide && 'main--wide']}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <p class="site-footer__heading">{siteConfig.siteName}</p>
          <p>{siteConfig.tagline}. Client-side calculators — amounts never leave your browser.</p>
          <p>
            Maintained by <a href={`/about/${siteConfig.authorHash}`}>{siteConfig.authorName}</a> ·{' '}
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </p>
        </div>
        <div>
          <p class="site-footer__heading">Tools</p>
          <ul>
            <li><a href="/tools/stripe-fee-calculator/">Stripe</a></li>
            <li><a href="/tools/paypal-fee-calculator/">PayPal</a></li>
            <li><a href="/tools/compare-payment-fees/">Compare fees</a></li>
            <li><a href="/payment-processors/">All processors</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer__heading">Site</p>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/methodology/">Methodology</a></li>
            <li><a href="/fee-changelog/">Fee changelog</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <div class="cookie-banner" data-cookie-banner role="dialog" aria-label="Cookie and analytics consent" aria-modal="false">
      <p class="cookie-banner__text">
        <span class="cookie-banner__short">We use cookies for analytics. </span>
        <span class="cookie-banner__long">
          Essential preferences stay on-device. Accept to enable Google Analytics (anonymized IP). See our{' '}
        </span>
        <a href="/privacy/">Privacy</a>
        <span class="cookie-banner__long"> policy.</span>
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--secondary" data-cookie-reject>Reject</button>
        <button type="button" class="btn btn--primary" data-cookie-accept>Accept</button>
      </div>
    </div>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');

      function setNavOpen(open: boolean) {
        nav?.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      toggle?.addEventListener('click', () => {
        const open = !(toggle.getAttribute('aria-expanded') === 'true');
        setNavOpen(open);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (toggle?.getAttribute('aria-expanded') === 'true') {
          setNavOpen(false);
          toggle.focus();
        }
      });

      const CONSENT_KEY = 'feecalc-consent-v2';
      const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

      function applyConsent(granted: boolean) {
        const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        if (typeof gtag === 'function') {
          gtag('consent', 'update', {
            analytics_storage: granted ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
        }
        if (granted) {
          const load = (window as unknown as { __feecalcLoadGa?: () => void }).__feecalcLoadGa;
          load?.();
        }
      }

      function hideBanner() {
        banner?.classList.remove('is-visible');
        document.body.classList.remove('has-cookie-banner');
      }

      const stored = localStorage.getItem(CONSENT_KEY);
      if (stored === 'granted') {
        applyConsent(true);
      } else if (stored === 'denied') {
        applyConsent(false);
      } else if (banner) {
        banner.classList.add('is-visible');
        document.body.classList.add('has-cookie-banner');
      }

      document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'granted');
        applyConsent(true);
        hideBanner();
      });
      document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'denied');
        applyConsent(false);
        hideBanner();
      });

      // Defer GA load until idle or first interaction when consent already granted
      if (stored === 'granted') {
        const load = () => (window as unknown as { __feecalcLoadGa?: () => void }).__feecalcLoadGa?.();
        if ('requestIdleCallback' in window) {
          (window as unknown as { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void }).requestIdleCallback(load, {
            timeout: 4000,
          });
        } else {
          window.addEventListener('load', () => setTimeout(load, 1), { once: true });
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((evt) => {
          window.addEventListener(evt, load, { once: true, passive: true });
        });
      }

      // Outbound reference / official pricing clicks
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a) return;
        try {
          const url = new URL(a.href, window.location.href);
          if (url.origin !== window.location.origin) {
            (window as unknown as { __feecalcTrack?: (n: string, p?: Record<string, string>) => void }).__feecalcTrack?.(
              'outbound_reference_click',
              { link_url: url.href, link_text: (a.textContent || '').trim().slice(0, 100) },
            );
          }
        } catch {
          /* ignore */
        }
      });
    </script>
  </body>
</html>
