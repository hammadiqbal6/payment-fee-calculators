{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/docs-fee-update", "destination": "/methodology/", "permanent": true },
    { "source": "/docs-fee-update/", "destination": "/methodology/", "permanent": true },
    {
      "source": "/guides/what-does-ebay-not-cover",
      "destination": "/guides/hidden-payment-fees/",
      "permanent": true
    },
    {
      "source": "/guides/what-does-ebay-not-cover/",
      "destination": "/guides/hidden-payment-fees/",
      "permanent": true
    },
    {
      "source": "/guides/how-much-to-charge-to-receive-100",
      "destination": "/guides/how-to-price-after-fees/",
      "permanent": true
    },
    {
      "source": "/guides/how-much-to-charge-to-receive-100/",
      "destination": "/guides/how-to-price-after-fees/",
      "permanent": true
    }
  ]
}
