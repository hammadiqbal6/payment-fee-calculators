      {
        "@type": "Question",
        "name": "Does Ko-fi take a fee?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Free plan: 0% on one-time tips; 5% on memberships, shop, and commissions. Standard mode: 5% on all payment types. Gold can remove tip platform fees."
        }
      },
      {
        "@type": "Question",
        "name": "Are PayPal/Stripe payout fees included?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Schedules note processing where relevant; verify your payout method’s fees separately."
        }
      },
      {
        "@type": "Question",
        "name": "When does Gold pay for itself?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "When monthly tip volume × avoided 5% exceeds Gold’s monthly price. Plug your tips into the Standard vs Gold schedules to compare."
        }
      }
    ]
