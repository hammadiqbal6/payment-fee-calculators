      {
        "@type": "Question",
        "name": "What is the Buy Me a Coffee fee percentage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "5% platform + Stripe ~2.9% + $0.30 + 0.5% payout (≈8.4% + $0.30 blended). Intl +1% and subscriptions +0.5% may apply. See BMAC’s help article on calculating charges."
        }
      },
      {
        "@type": "Question",
        "name": "How do chargebacks work on Buy Me a Coffee?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Disputes can reverse a support and may include processor fees. Keep delivery records for shop and membership products, and read BMaC’s chargeback help article before large launches."
        }
      },
      {
        "@type": "Question",
        "name": "Are memberships priced the same as one-off coffees?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Platform percent is the same 5%, but subscriptions can add 0.5% processing. Model ARPU × patron count, not only a single $5 tip."
        }
      }
    ]
