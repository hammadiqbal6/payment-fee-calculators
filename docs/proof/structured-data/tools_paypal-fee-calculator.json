      {
        "@type": "Question",
        "name": "How much does PayPal take on Goods & Services?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In the US, Send/Receive Money for Goods & Services is 2.99% with no fixed fee. PayPal Checkout is 3.49% + $0.49."
        }
      },
      {
        "@type": "Question",
        "name": "Is PayPal Friends & Family free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Often yes when funded from PayPal balance or a linked bank. Card-funded F&F can incur a fee."
        }
      },
      {
        "@type": "Question",
        "name": "What about PayPal fees in India, UK, or Australia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "UK and Australia publish domestic commercial rates (often near 2.9% + a fixed fee). PayPal India supports international receiving only — currently 4.40% + a currency-specific fixed fee (₹3.00 for INR). Use the matching schedule here, then confirm on that country’s PayPal business fees page."
        }
      }
