# Copy to `.env` for local builds. Cloudflare Workers Builds: set the same names
# as build (and, where noted, deploy) environment variables.
# Never put real secrets here — PUBLIC_* values are embedded in static HTML.
# Values below match the live Workers site unless left empty on purpose.

# --- Site identity (Astro / src/config/site.ts) ---

# Canonical site origin, no trailing slash (canonicals, sitemap, JSON-LD, robots).
PUBLIC_SITE_URL=https://payment-fee-calculators.hammadiqbal117.workers.dev

# Full site name for titles and JSON-LD.
PUBLIC_SITE_NAME=FeeCalc Tools

# Short brand shown in the header.
PUBLIC_SITE_SHORT_NAME=FeeCalc

# Public contact email (footer, contact/privacy/terms, JSON-LD, llms.txt).
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Author/reviewer display name (authors page, bylines, JSON-LD).
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Author bio shown on /authors/ (override to customize; default is generated in site.ts).
PUBLIC_AUTHOR_BIO=

# Public profile links for E-E-A-T (authors/contact pages).
PUBLIC_AUTHOR_GITHUB=https://github.com/hammadiqbal6
PUBLIC_AUTHOR_LINKEDIN=

# Twitter/X handle without @. Leave empty to skip twitter:site.
PUBLIC_TWITTER_HANDLE=

# Custom domain: set PUBLIC_SITE_URL to https://your-domain.example (no trailing slash)
# after attaching the domain in Cloudflare Workers/Pages. Canonicals and the sitemap follow it.

# --- AdSense (leave empty until publisher approval) ---

# AdSense publisher ID (ca-pub-…). Empty → ads disabled; AdSlot renders nothing.
PUBLIC_ADSENSE_PUBLISHER_ID=

# AdSense ad unit slot IDs are assigned in AdSense after approval and passed as
# AdSlot props — there is no env var for slots yet. Leave publisher ID empty for now.

# --- Analytics & search verification ---

# Google Analytics 4 measurement ID (G-XXXXXXXX).
PUBLIC_GA4_MEASUREMENT_ID=G-QG36XZRHPK

# Deprecated alias for PUBLIC_GA4_MEASUREMENT_ID (used only if MEASUREMENT_ID is unset).
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification content value.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Bing Webmaster Tools msvalidate.01 content value. Optional.
PUBLIC_BING_VERIFICATION=

# IndexNow 32-char hex key for the site build (must match public/<key>.txt).
PUBLIC_INDEXNOW_KEY=cded36863aa6be8ac5bf690ab6889910

# --- IndexNow post-deploy script (scripts/indexnow.mjs; process.env) ---

# Override IndexNow key for the deploy ping (defaults to the same key as above).
INDEXNOW_KEY=cded36863aa6be8ac5bf690ab6889910

# Set to 1 to skip the IndexNow sitemap ping after deploy.
INDEXNOW_DISABLE=

# --- Scripts / CI (process.env; not embedded in the site) ---

# Set automatically on GitHub Actions; enables Chromium --no-sandbox in proof runs.
CI=

# Set to 1 to skip rebuilding dist/ inside scripts/proof/run.mjs.
SKIP_REBUILD=
