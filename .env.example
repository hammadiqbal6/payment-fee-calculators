# Copy to `.env` for local builds. All values are optional unless noted.
# Cloudflare Workers Builds: set the same names as build environment variables.
# Never put real secrets here — these PUBLIC_* vars are embedded in static HTML.

# Canonical site origin, no trailing slash. Required for correct canonicals/sitemap in production.
# Example: https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL=

# Full site name for titles and JSON-LD. Optional (default: FeeCalc Tools).
PUBLIC_SITE_NAME=

# Short brand shown in the header. Optional (default: FeeCalc).
PUBLIC_SITE_SHORT_NAME=

# Public contact email (footer, contact page, schema). Optional (defaults from site host).
PUBLIC_CONTACT_EMAIL=

# Author/reviewer display name. Optional (default: FeeCalc Editorial).
PUBLIC_AUTHOR_NAME=

# Twitter/X handle without @. Optional; omit to skip twitter:site.
PUBLIC_TWITTER_HANDLE=

# AdSense publisher ID (ca-pub-…). Optional; leave empty to keep ads disabled.
PUBLIC_ADSENSE_PUBLISHER_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXX). Optional; leave empty to emit no analytics.
PUBLIC_GA4_MEASUREMENT_ID=

# Deprecated alias for PUBLIC_GA4_MEASUREMENT_ID. Optional; used only if MEASUREMENT_ID is unset.
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification content value. Optional.
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 content value. Optional.
PUBLIC_BING_VERIFICATION=

# IndexNow 32-char hex key (must match public/<key>.txt). Optional placeholder: all zeros.
PUBLIC_INDEXNOW_KEY=00000000000000000000000000000000
