/**
 * Pure static-assets Worker (no Astro Cloudflare adapter, no bindings).
 * Workers Builds: npm run build → npx wrangler deploy && node scripts/indexnow.mjs
 * (IndexNow ping must run after deploy so public/<key>.txt is live.)
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "payment-fee-calculators",
  // Current date at config authoring; bump when adopting new runtime APIs
  "compatibility_date": "2026-10-19",
  // Worker issues 308 trailing-slash redirects before assets (html_handling alone uses 307)
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Astro SSG with src/pages/404.astro → dist/404.html
    "not_found_handling": "404-page",
    // Matches astro.config trailingSlash: 'always' (slash redirects handled in worker as 308)
    "html_handling": "force-trailing-slash"
  }
}
